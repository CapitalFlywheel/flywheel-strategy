{
  "name": "flywheel-strategy-solana",
  "version": "0.1.0",
  "private": true,
  "description": "Automatic MSTRx holder rewards and a strategic reserve funded by Pump.fun creator fees on Solana",
  "scripts": {
    "compile": "npm run compile:legacy",
    "compile:legacy": "hardhat compile",
    "test": "npm run test:solana && npm run test:web",
    "test:solana": "vitest run services/solana services/api/adminRoutePolicy.test.ts services/api/publicSolanaRpc.test.ts services/api/governanceVoteRelay.test.ts services/indexer/holdingMath.test.ts services/indexer/distribution.test.ts scripts/solana-rpc-smoke.test.ts scripts/solana-test-readiness.test.ts scripts/solana-staging-web-readiness.test.ts programs/solana-governance/governanceVectors.test.ts --exclude outputs/**",
    "probe:solana-rpc": "tsx scripts/solana-rpc-smoke.ts",
    "preflight:solana-test": "tsx scripts/solana-test-readiness.ts",
    "preflight:solana-web": "tsx scripts/solana-staging-web-readiness.ts",
    "test:legacy": "hardhat test",
    "test:indexer": "vitest run services --exclude outputs/**",
    "test:web": "vitest run apps/web/src/wallets.test.ts apps/web/src/solanaWalletConnect.test.ts apps/web/src/governanceClient.test.ts apps/web/src/voteConfirmation.test.ts apps/web/src/solanaAdmin.test.tsx apps/web/src/offchainGovernance.test.tsx --exclude outputs/**",
    "test:all": "npm run test && npm run test:indexer && npm run test:legacy",
    "test:fork": "cross-env ROBINHOOD_FORK=true RUN_FORK_TESTS=true hardhat test test/fork.mstr.test.js",
    "deploy:local": "hardhat run scripts/deploy-local.js",
    "deploy:prelaunch": "hardhat run scripts/deploy-prelaunch.js --network robinhood",
    "deploy:postlaunch": "hardhat run scripts/deploy-postlaunch.js --network robinhood",
    "deploy:testnet": "hardhat run scripts/deploy-testnet-rehearsal.js --network robinhoodTestnet",
    "verify:live": "node scripts/verify-live-config.mjs",
    "verify:postlaunch": "node scripts/verify-postlaunch.mjs",
    "verify:admin-manifest:live": "tsx scripts/verify-existing-admin-manifests.ts",
    "verify:pons-detection:live": "tsx scripts/verify-pons-launch-detection.ts",
    "status:rewards": "node scripts/reward-cycle-status.mjs",
    "status:test-holders": "node scripts/test-holder-status.mjs",
    "verify:holder-claim": "node scripts/verify-holder-claim.mjs",
    "setup:rpc": "node scripts/configure-rpc.mjs",
    "prepare:launch": "node scripts/prepare-pons-launch.mjs",
    "quote:mstr": "tsx services/automation/quoteCli.ts",
    "snapshot:weights": "tsx services/indexer/snapshotCli.ts",
    "snapshot:governance": "tsx services/governance/snapshotCli.ts",
    "prepare:proposal": "node scripts/prepare-governance-proposal.mjs",
    "keeper:governance": "tsx services/keeper/governanceKeeper.ts",
    "keeper:launch-watcher": "tsx services/keeper/launchWatcher.ts",
    "keeper:rewards": "tsx services/keeper/rewardKeeper.ts",
    "keeper:publisher": "tsx services/keeper/rewardPublisher.ts",
    "solana:control-runner": "sh scripts/solana-singleton.sh control-runner",
    "solana:holder-indexer": "sh scripts/solana-singleton.sh holder-indexer",
    "security:secrets": "node scripts/check-public-secrets.mjs",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "web:serve": "tsx services/api/server.ts"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@openzeppelin/contracts": "5.4.0",
    "@pump-fun/pump-sdk": "^2.0.0",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-adapter-base": "0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/web3.js": "^1.99.0",
    "@walletconnect/ethereum-provider": "2.24.0",
    "@walletconnect/solana-adapter": "0.0.9",
    "bs58": "^6.0.0",
    "buffer": "6.0.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@openzeppelin/merkle-tree": "1.0.8",
    "@types/node": "22.10.5",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "hardhat": "2.28.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "viem": "2.56.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  },
  "overrides": {
    "axios": "1.18.0",
    "viem": "2.56.3",
    "ws": "8.21.0"
  }
}
